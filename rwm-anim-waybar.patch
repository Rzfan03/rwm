+void
+ghostanim(Monitor *m, struct wlr_scene_node *node, int dx, int dy)
+{
+	Ghost *g = ecalloc(1, sizeof(*g));
+
+	g->node = node;
+	g->mon = m;
+	g->x0 = node->x;
+	g->y0 = node->y;
+	g->x1 = g->x0 + dx;
+	g->y1 = g->y0 + dy;
+	g->start = nowms();
+	g->alpha = 1.0f;
+	wl_list_insert(&animghosts, &g->link);
+	wlr_output_schedule_frame(m->wlr_output);
+}
+
+void
+ghostfade(struct wlr_scene_node *node, float a, float ratio)
+{
+	struct wlr_scene_node *child;
+	struct wlr_scene_rect *rect;
+	float col[4];
+	int i;
+
+	switch (node->type) {
+	case WLR_SCENE_NODE_TREE:
+		wl_list_for_each(child, &wlr_scene_tree_from_node(node)->children, link)
+			ghostfade(child, a, ratio);
+		break;
+	case WLR_SCENE_NODE_BUFFER:
+		wlr_scene_buffer_set_opacity(wlr_scene_buffer_from_node(node), a);
+		break;
+	case WLR_SCENE_NODE_RECT: /* borders fade too */
+		rect = wlr_scene_rect_from_node(node);
+		for (i = 0; i < 4; i++)
+			col[i] = rect->color[i] * ratio;
+		wlr_scene_rect_set_color(rect, col);
+		break;
+	default:
+		break;
+	}
+}
+
+/* m == NULL: only free the records (scene is torn down separately) */
+void
+dropghosts(Monitor *m)
+{
+	Ghost *g, *tmp;
+
+	wl_list_for_each_safe(g, tmp, &animghosts, link) {
+		if (m && g->mon != m)
+			continue;
+		if (m)
+			wlr_scene_node_destroy(g->node);
+		wl_list_remove(&g->link);
+		free(g);
+	}
+}
